<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/state_unchecked"
        android:drawable="@drawable/ic_favorite"
        android:state_checked="false"/>

    <item
        android:id="@+id/state_checked"
        android:drawable="@drawable/ic_bookmark_filled"
        android:state_checked="true"/>

    <transition
        android:fromId="@id/state_unchecked"
        android:toId="@id/state_checked">
        <animated-vector
            xmlns:aapt="http://schemas.android.com/aapt"
            android:drawable="@drawable/ic_favorite">
            <!-- Add path animations if needed -->
        </animated-vector>
    </transition>

    <transition
        android:fromId="@id/state_checked"
        android:toId="@id/state_unchecked">
        <animated-vector
            xmlns:aapt="http://schemas.android.com/aapt"
            android:drawable="@drawable/ic_bookmark_filled">
            <!-- Add path animations if needed -->
        </animated-vector>
    </transition>
</animated-selector>